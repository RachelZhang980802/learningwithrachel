{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "./worker/runtime.d.ts",
      "node"
    ]
  },
  "include": [
    "worker/**/*.ts",
    "db/**/*.ts"
  ]
}
